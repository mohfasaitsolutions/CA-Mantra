{
  "info": {
    "_postman_id": "cahero-users-collection",
    "name": "CAHero Users",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "User profile & admin user management endpoints."
  },
  "item": [
    {
      "name": "Get My Profile",
      "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/users/me","host":["{{baseUrl}}"],"path":["users","me"]}}
    },
    {
      "name": "Update My Profile",
      "request": {"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"fullName\": \"Updated User\",\n  \"mobile\": \"+1234567890\",\n  \"address\": \"123 Main St, City, State\"\n}"},"url":{"raw":"{{baseUrl}}/users/me","host":["{{baseUrl}}"],"path":["users","me"]}}
    },
    {
      "name": "Send Mobile OTP",
      "request": {"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/users/send-mobile-otp","host":["{{baseUrl}}"],"path":["users","send-mobile-otp"]}}
    },
    {
      "name": "Verify Mobile OTP",
      "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"otp\": \"123456\"\n}"},"url":{"raw":"{{baseUrl}}/users/verify-mobile-otp","host":["{{baseUrl}}"],"path":["users","verify-mobile-otp"]}}
    },
    {
      "name": "Admin Create Admin/Evaluator",
      "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{adminToken}}"}],"body":{"mode":"raw","raw":"{\n  \"fullName\": \"Eval One\",\n  \"email\": \"eval1@example.com\",\n  \"password\": \"secret123\",\n  \"caLevel\": \"FOUNDATION\",\n  \"role\": \"EVALUATOR\"\n}"},"url":{"raw":"{{baseUrl}}/users","host":["{{baseUrl}}"],"path":["users"]}}
    },
    {
      "name": "Admin List Users",
      "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":{"raw":"{{baseUrl}}/users","host":["{{baseUrl}}"],"path":["users"]}}
    }
  ],
  "variable": [ {"key":"baseUrl","value":"http://localhost:3000/api"},{"key":"token","value":""},{"key":"adminToken","value":""} ]
}
